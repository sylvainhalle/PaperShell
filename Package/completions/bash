# Automatically generated by ChatGPT from the man page (better be honest!)
_papershell()
{
  local cur prev words cword
  COMPREPLY=()

  _init_completion -n : || return

  local verbs="init export mk th tx ld"
  local th_cmds="list install uninstall"
  local tx_cmds="check wc"

  case "$prev" in
    export)
      COMPREPLY=( $(compgen -W "-f -i -z" -- "$cur") )
      _filedir -d
      return
      ;;
    install|uninstall)
      _filedir
      return
      ;;
    ld)
      _filedir -d
      return
      ;;
  esac

  case "${words[1]}" in
    th)
      if [[ $cword -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "$th_cmds" -- "$cur") )
      else
        case "${words[2]}" in
          install)
            COMPREPLY=( $(compgen -W "-f" -- "$cur") )
            _filedir
            ;;
          uninstall)
            ;;
        esac
      fi
      ;;
    tx)
      if [[ $cword -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "$tx_cmds" -- "$cur") )
      elif [[ "${words[2]}" == "check" ]]; then
        COMPREPLY=( $(compgen -W "-b" -- "$cur") )
      fi
      ;;
    mk)
      if [[ $cword -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "c" -- "$cur") )
      fi
      ;;
    export)
      COMPREPLY=( $(compgen -W "-f -i -z" -- "$cur") )
      _filedir -d
      ;;
    *)
      if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$verbs -h --help" -- "$cur") )
      fi
      ;;
  esac
}

complete -F _papershell papershell